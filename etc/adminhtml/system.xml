<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="verificounity" translate="label" sortOrder="1" class="verifico-tab verifico-tab-container">
            <label>AgeChecked Plus+</label>
        </tab>
        <section id="verificounitysection" translate="label" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Settings</label>
            <tab>verificounity</tab>
            <resource>Verifico_Ageverify::age_configuration</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                <attribute type="expanded">1</attribute>                

                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Age Verification</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disable to turn off all AgeChecked Plus+ functionality for this scope.</comment>
                </field>

                <field id="only_flagged_products" translate="label" type="select" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Verify Mode</label>
                    <source_model>Verifico\Ageverify\Model\Config\Source\Allspecificproducts</source_model>
                    <comment>You can set which products you want age verification on. By default all orders are verified.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>


                <field id="assign_category" translate="label" type="multiselect" sortOrder="92" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select categories to verify</label>
                    <source_model>Verifico\Ageverify\Model\Config\Source\Categorylist</source_model>
                    <depends>
                        <field id="only_flagged_products">2</field>
                    </depends>
                </field>

                <field id="assign_products" translate="label" type="note" sortOrder="93" showInDefault="1" showInWebsite="1" showInStore="1">
                    
                    <depends>
                        <field id="only_flagged_products">1</field>
                    </depends>
                    <comment>You can set an individual product to verify by editing the product in the Magento admin panel and placing a tick in the AgeChecked section.</comment>
                
                </field>
                <field id="allowed_countries" translate="label" type="multiselect" sortOrder="102" showInDefault="1" showInWebsite="1" canRestore="1">
                    <label>Allow Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>By default this is limited to GB only.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>
                <field id="hold_orders" translate="label" type="select" sortOrder="105" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hold Orders Awaiting Age Verification</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Put orders that need age verification on hold when they are placed, so they are not fulfilled before the customer is verified. Orders still waiting for payment are not held. Release them yourself, or let AgeChecked Plus+ release them if your package does.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>
                <field id="cron_enable" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Pending Orders in Background</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Every 5 minutes, send orders still awaiting age verification to AgeChecked Plus+ in case the checkout success page did not. Each order is sent once.</comment>
                    <depends>
                        <field id="enable">1</field>
                    </depends>
                </field>
                <field id="cron_lookback_hours" translate="label" type="text" sortOrder="111" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Only Send Orders Placed Within (hours)</label>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <comment>Orders older than this are never sent, so historical orders are left alone.</comment>
                    <depends>
                        <field id="enable">1</field>
                        <field id="cron_enable">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>