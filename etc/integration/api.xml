<integrations>
    <integration name="AgeCheckedPlus+Verifico">
        <resources>
            <!-- Parents of the order and invoice permissions below, declared as Magento's integration docs require -->
            <resource name="Magento_Sales::sales" />
            <resource name="Magento_Sales::sales_operation" />
            <resource name="Magento_Sales::sales_order" />
            <resource name="Magento_Sales::actions" />
            <!-- GET /V1/orders/{id} -->
            <resource name="Magento_Sales::actions_view" />
            <!-- POST /V1/orders/{id}/hold and /unhold -->
            <resource name="Magento_Sales::hold" />
            <resource name="Magento_Sales::unhold" />
            <!-- POST /V1/orders/{id}/comments -->
            <resource name="Magento_Sales::comment" />
            <!-- POST /V1/orders (set the Age Verification Status): create up to Magento 2.4.7, api_actions from 2.4.8 -->
            <resource name="Magento_Sales::create" />
            <resource name="Magento_Sales::api_actions" />
            <!-- GET /V1/invoices and POST /V1/invoice/{id}/refund -->
            <resource name="Magento_Sales::sales_invoice" />
        </resources>
    </integration>
</integrations>
